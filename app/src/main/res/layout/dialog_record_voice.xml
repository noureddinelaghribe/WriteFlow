<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/white">

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/mic"
            app:tint="@color/black"
            android:layout_marginRight="10dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Record Voice"
            android:textColor="@color/c4"
            android:textSize="18sp"
            android:textStyle="bold" />

<!--        <ImageView-->
<!--            android:id="@+id/imageViewClose"-->
<!--            android:layout_width="24dp"-->
<!--            android:layout_height="24dp"-->
<!--            android:src="@drawable/close"-->
<!--            app:tint="@color/black"-->
<!--            android:clickable="true"-->
<!--            android:focusable="true"-->
<!--            android:background="?android:attr/selectableItemBackgroundBorderless" />-->

    </LinearLayout>

    <!-- Recording Interface Section -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/c5"
            android:padding="20dp"
            android:gravity="center">

            <!-- Recording Status -->
            <TextView
                android:id="@+id/textViewRecordingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ready to record"
                android:textColor="@color/c4"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="15dp" />

            <!-- Timer Display -->
            <TextView
                android:id="@+id/textViewTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/c4"
                android:textSize="32sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_marginBottom="20dp" />

            <!-- Waveform/Visual Indicator -->
            <LinearLayout
                android:id="@+id/layoutWaveform"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="20dp">

                <View
                    android:id="@+id/bar1"
                    android:layout_width="4dp"
                    android:layout_height="8dp"
                    android:layout_margin="2dp"
                    android:background="@color/c6" />

                <View
                    android:id="@+id/bar2"
                    android:layout_width="4dp"
                    android:layout_height="16dp"
                    android:layout_margin="2dp"
                    android:background="@color/c6" />

                <View
                    android:id="@+id/bar3"
                    android:layout_width="4dp"
                    android:layout_height="24dp"
                    android:layout_margin="2dp"
                    android:background="@color/c6" />

                <View
                    android:id="@+id/bar4"
                    android:layout_width="4dp"
                    android:layout_height="32dp"
                    android:layout_margin="2dp"
                    android:background="@color/c4" />

                <View
                    android:id="@+id/bar5"
                    android:layout_width="4dp"
                    android:layout_height="24dp"
                    android:layout_margin="2dp"
                    android:background="@color/c6" />

                <View
                    android:id="@+id/bar6"
                    android:layout_width="4dp"
                    android:layout_height="16dp"
                    android:layout_margin="2dp"
                    android:background="@color/c6" />

                <View
                    android:id="@+id/bar7"
                    android:layout_width="4dp"
                    android:layout_height="8dp"
                    android:layout_margin="2dp"
                    android:background="@color/c6" />

            </LinearLayout>

            <!-- Recording Quality Info -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="High Quality • 44.1 kHz"
                android:textColor="@color/c6"
                android:textSize="12sp"
                android:layout_marginBottom="10dp" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Recording Controls -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_plan_selector"
            android:padding="15dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:text="Recording Controls"
                android:textColor="@color/c4"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/linearLayoutPause"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:alpha="0.5"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginBottom="5dp"
                        android:src="@drawable/ic_pause" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pause"
                        android:textColor="@color/c4"
                        android:textSize="12sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/linearLayoutStop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:alpha="0.5"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginBottom="5dp"
                        android:src="@drawable/ic_stop" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Stop"
                        android:textColor="@color/c4"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/buttonCancel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_gray"
                    android:padding="12dp"
                    android:text="Cancel"
                    android:textAllCaps="false"
                    android:textColor="@color/c4" />

                <Button
                    android:id="@+id/buttonStopAndSave"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_upgrade"
                    android:padding="12dp"
                    android:text="Save"
                    android:textAllCaps="false"
                    android:textColor="@color/white" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>